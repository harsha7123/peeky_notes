# Server configuration. In production set these in your host's dashboard (see render.yaml).
NODE_ENV=development
PORT=8787
# Public https address of the site; used in emails, Stripe redirects and desktop sign-in links.
PUBLIC_URL=http://localhost:8787
# Where the SQLite database lives (a persistent disk in production).
PEEKY_DATA_DIR=./server/data

# Stripe (https://dashboard.stripe.com/apikeys). Without a key: development = free test purchases, production = store closed.
STRIPE_SECRET_KEY=
# Webhook endpoint: <PUBLIC_URL>/api/stripe/webhook, events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Email (https://resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Peeky <hello@example.com>

# Shown on /privacy and /terms.
COMPANY_NAME=Peeky
SUPPORT_EMAIL=support@example.com

# Optional: where "Download for Windows" points (otherwise the newest .exe in server/downloads/).
WINDOWS_DOWNLOAD_URL=

# Local demo account created by `npm run seed` (development only).
DEMO_EMAIL=demo@peeky.local
DEMO_PASSWORD=peeky-demo-2026
